{
  "name": "2048-versus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "relay": "node server/relay.mjs",
    "dev:online": "concurrently -k -n relay,web -c magenta,cyan \"npm run relay\" \"npm run dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:engine": "tsx src/game/engine.selftest.ts"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
